# Set these privately in Vercel and .env.local; never commit real passwords.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

# Enquiry email notifications (server-side API key)
RESEND_API_KEY=""
EMAIL_FROM="JCORE Notifications <notifications@jcoretransformers.com>"
EMAIL_TO="jcoretransformers@gmail.com"
NEXT_PUBLIC_SITE_URL="https://www.jcoretransformers.com"
